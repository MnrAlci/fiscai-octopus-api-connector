{
  "mcpServers": {
    "fiscai-octopus-api-connector": {
      "command": "/ABSOLUTE/PATH/TO/fiscai-octopus-api-connector/.venv/bin/python",
      "args": [
        "/ABSOLUTE/PATH/TO/fiscai-octopus-api-connector/server/run_server.py"
      ],
      "env": {
        "OCTOPUS_SOFTWARE_HOUSE_UUID": "${OCTOPUS_SOFTWARE_HOUSE_UUID}",
        "OCTOPUS_USER": "${OCTOPUS_USER}",
        "OCTOPUS_PASSWORD": "${OCTOPUS_PASSWORD}",
        "OCTOPUS_CACHE_KEY": "${OCTOPUS_CACHE_KEY}",
        "OCTOPUS_LOCALE_ID": "1"
      }
    }
  }
}
