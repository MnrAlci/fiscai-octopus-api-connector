# Variables for the Grok Bot plugin form (names only; enter the real values in Grok Bot's own settings,
# never in a file that is shared or committed). Example values are placeholders.
OCTOPUS_SOFTWARE_HOUSE_UUID=YOUR_OCTOPUS_SOFTWARE_HOUSE_UUID
OCTOPUS_USER=YOUR_OCTOPUS_USER
OCTOPUS_PASSWORD=YOUR_OCTOPUS_PASSWORD
# At least 16 characters: encrypted cache and sync (saves the very low daily limits)
OCTOPUS_CACHE_KEY=YOUR_RANDOM_CACHE_KEY
# 1 NL, 2 FR, 3 EN, 4 DE
OCTOPUS_LOCALE_ID=1
# Leave unset: writing to Octopus stays disabled.
# OCTOPUS_WRITE_ENABLED=
